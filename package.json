{
  "name": "@skitterbyte/skittership",
  "version": "2.0.4",
  "description": "Changelog + user-facing release-notes tooling for Claude Code — installs the /commit skill, commit-message rule, and release-artifact generators into any project.",
  "keywords": [
    "claude",
    "claude-code",
    "changelog",
    "release-notes",
    "conventional-commits",
    "semver",
    "scaffold"
  ],
  "license": "MIT",
  "author": "Reuben Greaves",
  "type": "commonjs",
  "packageManager": "pnpm@11.11.0",
  "bin": {
    "skittership": "bin/skittership.js"
  },
  "files": [
    "bin",
    "src",
    "assets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "prompts": "^2.4.2"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node --test",
    "version": "node scripts/generate-changelog.cjs && node scripts/generate-releases.cjs && git add CHANGELOG.md RELEASES.md && node scripts/check-release-index.cjs",
    "postversion": "git push --follow-tags",
    "changelog": "node scripts/generate-changelog.cjs",
    "changelog:retro": "node scripts/generate-changelog.cjs --retro",
    "releases": "node scripts/generate-releases.cjs",
    "releases:retro": "node scripts/generate-releases.cjs --retro",
    "approve": "node scripts/approve-release.cjs",
    "staged": "npm stage list"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkitterByte/skittership.git"
  },
  "devDependencies": {
    "@skitterbyte/skitterspec": "^18.0.0"
  }
}
