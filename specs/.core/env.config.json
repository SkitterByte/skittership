{
  "mode": "worktree",
  "worktree": {
    "root": "../{repo}-wt",
    "folderPattern": "{slug}"
  },
  "docker": {
    "enabled": false,
    "composeFile": "docker-compose.yml",
    "projectNamePattern": "{repoSlug}_{slug}",
    "portBase": 3000,
    "portsPerSpec": 10,
    "envFile": ".env",
    "backupCommand": ""
  },
  "seedFiles": {
    "mode": "symlink",
    "files": []
  },
  "setup": [
    "npm ci"
  ],
  "dev": [],
  "proxy": {
    "enabled": true,
    "host": "127.0.0.1"
  },
  "open": {
    "command": ""
  },
  "registry": ".spec-env/registry.json",
  "branch": {
    "pattern": "{type}/{slug}",
    "identifierField": ""
  },
  "spec": {
    "companionPaths": []
  },
  "baseBranch": "",
  "guards": {
    "refuseTeardownIfDirty": true,
    "refuseTeardownIfUnpushed": true
  },
  "live": {
    "migrations": []
  }
}
